# Puerto del servidor
PORT=3000

# Cadena de conexión de MongoDB (Atlas o local). Ejemplo Atlas:
# mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/technova?retryWrites=true&w=majority
# También se aceptan MONGO_URI y MONGO_PUBLIC_URL (compatibilidad con PropinasApp).
MONGODB_URI=mongodb://127.0.0.1:27017/technova
# Nombre de la base de datos (opcional; se infiere de la URI si no se pone)
MONGODB_DB=technova

# Contraseña del panel del vendedor (/admin)
ADMIN_PASSWORD=cambia-esta-clave

# Número de WhatsApp (formato internacional sin +) usado al redirigir pedidos
WA_NUMBER=56961112430

# Datos de la empresa (aparecen en las facturas)
COMPANY_NAME=TechNova
COMPANY_RFC=
COMPANY_ADDRESS=Tu dirección, Ciudad
COMPANY_PHONE=+52 1 00 0000 0000
COMPANY_EMAIL=hola@technova.mx
